# ─── Application ──────────────────────────────────────────────
APP_NAME=UbumweConnect
APP_VERSION=1.0.0
DEBUG=False
SECRET_KEY=your-secret-key-at-least-32-characters-long-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ─── Database ─────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://ubumwe_user:password@localhost:5432/ubumwe_connect
DATABASE_URL_SYNC=postgresql://ubumwe_user:password@localhost:5432/ubumwe_connect

# ─── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Firebase ─────────────────────────────────────────────────
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# ─── OpenAI ───────────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key

# ─── AWS S3 ───────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=ubumwe-connect-storage

# ─── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","https://ubumweconnect.com"]

# ─── Email (for password reset) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@ubumweconnect.com
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Ubumwe Connect <noreply@ubumweconnect.com>

# ─── WebRTC / TURN ────────────────────────────────────────────
TURN_SERVER_URL=turn:your-turn-server.com:3478
TURN_USERNAME=ubumwe
TURN_PASSWORD=your-turn-password

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100
TRANSLATION_RATE_LIMIT_PER_MINUTE=20
